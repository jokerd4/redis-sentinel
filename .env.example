# ==============================================================================
# Application Configuration
# ==============================================================================
APP_PORT=3000
APP_HOST=0.0.0.0
NODE_ENV=production
APP_CONTAINER_NAME=nest-sentinel-app

# ==============================================================================
# Redis Master & Replicas Configuration
# ==============================================================================
REDIS_IMAGE=redis:7.2-alpine
REDIS_MASTER_NAME=mymaster
REDIS_MASTER_HOST=redis-master
REDIS_REPLICA_1_HOST=redis-replica-1
REDIS_REPLICA_2_HOST=redis-replica-2
REDIS_PORT=6379

# ==============================================================================
# Redis Sentinel Configuration (3 instances, Quorum = 2)
# ==============================================================================
SENTINEL_PORT=26379
SENTINEL_PORT_1=26379
SENTINEL_PORT_2=26380
SENTINEL_PORT_3=26381
SENTINEL_HOST_1=sentinel-1
SENTINEL_HOST_2=sentinel-2
SENTINEL_HOST_3=sentinel-3
SENTINEL_QUORUM=2
SENTINEL_DOWN_AFTER_MS=3000
SENTINEL_FAILOVER_TIMEOUT_MS=10000
SENTINEL_PARALLEL_SYNCS=1

# ==============================================================================
# Redis Client Connection & Timeout Settings
# ==============================================================================
REDIS_COMMAND_TIMEOUT_MS=8000
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=null
# Acknowledge a write only after N replicas confirmed it (WAIT). 0 = off (async replication)
REDIS_WAIT_REPLICAS=0
REDIS_WAIT_TIMEOUT_MS=1000
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=
